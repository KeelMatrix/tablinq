{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tablinq.local/schemas/v1/events.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "request_id", "emitted_at", "event"],
  "properties": {
    "version": { "const": "tablinq.v1" },
    "request_id": { "type": ["string", "null"], "minLength": 1 },
    "emitted_at": { "type": "string", "format": "date-time" },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "ack" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["accepted", "message"],
              "properties": {
                "accepted": { "type": "boolean" },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "stream_chunk" },
            "payload": { "$ref": "#/$defs/stream_chunk" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "capability_report" },
            "payload": { "$ref": "#/$defs/capability_report" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "job_state" },
            "payload": { "$ref": "#/$defs/job_state" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "artifact_ready" },
            "payload": { "$ref": "#/$defs/artifact_metadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "failure" },
            "payload": { "$ref": "#/$defs/failure_bundle" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "health_check" },
            "payload": { "$ref": "#/$defs/health_check" }
          }
        }
      ]
    }
  },
  "$defs": {
    "artifact_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "conversation_id",
        "message_id",
        "file_name",
        "content_type",
        "size_bytes",
        "sha256",
        "storage_path"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": ["string", "null"], "minLength": 1 },
        "message_id": { "type": ["string", "null"], "minLength": 1 },
        "file_name": { "type": "string", "minLength": 1 },
        "content_type": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "minLength": 1 },
        "storage_path": { "type": "string", "minLength": 1 }
      }
    },
    "capability_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composer_ready",
        "submit_available",
        "model_picker_visible",
        "thinking_effort_visible",
        "search_mode_visible",
        "research_mode_visible",
        "upload_control_visible",
        "downloadable_artifacts_observable"
      ],
      "properties": {
        "composer_ready": { "type": "boolean" },
        "submit_available": { "type": "boolean" },
        "model_picker_visible": { "type": "boolean" },
        "thinking_effort_visible": { "type": "boolean" },
        "search_mode_visible": { "type": "boolean" },
        "research_mode_visible": { "type": "boolean" },
        "upload_control_visible": { "type": "boolean" },
        "downloadable_artifacts_observable": { "type": "boolean" }
      }
    },
    "alias_map": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "capability_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_at",
        "selector_pack_id",
        "selector_pack_version",
        "matrix",
        "aliases"
      ],
      "properties": {
        "reported_at": { "type": "string", "format": "date-time" },
        "selector_pack_id": { "type": "string", "minLength": 1 },
        "selector_pack_version": { "type": "string", "minLength": 1 },
        "matrix": { "$ref": "#/$defs/capability_matrix" },
        "aliases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modes", "model_classes", "efforts"],
          "properties": {
            "modes": { "$ref": "#/$defs/alias_map" },
            "model_classes": { "$ref": "#/$defs/alias_map" },
            "efforts": { "$ref": "#/$defs/alias_map" }
          }
        }
      }
    },
    "stream_chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "conversation_id",
        "message_id",
        "seq",
        "kind",
        "text"
      ],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": ["string", "null"], "minLength": 1 },
        "message_id": { "type": ["string", "null"], "minLength": 1 },
        "seq": { "type": "integer", "minimum": 0 },
        "kind": {
          "type": "string",
          "enum": ["delta", "citation", "status", "done"]
        },
        "text": { "type": "string" }
      }
    },
    "job_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "status",
        "message",
        "conversation_id",
        "updated_at",
        "artifacts"
      ],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "starting",
            "running",
            "interrupted",
            "recovered",
            "waiting_for_sources",
            "completed",
            "failed",
            "artifact_ready"
          ]
        },
        "message": { "type": ["string", "null"], "minLength": 1 },
        "conversation_id": { "type": ["string", "null"], "minLength": 1 },
        "updated_at": { "type": "string", "format": "date-time" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_metadata" }
        }
      }
    },
    "strategy_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "strategy_id", "score", "outcome", "detail"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "strategy_id": { "type": "string", "minLength": 1 },
        "score": { "type": "number" },
        "outcome": { "type": "string", "minLength": 1 },
        "detail": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "failure_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "error_code",
        "message",
        "created_at",
        "url",
        "mode",
        "screenshot_path",
        "dom_snapshot_path",
        "aria_snapshot_path",
        "logs_path",
        "strategy_attempts",
        "capability_matrix"
      ],
      "properties": {
        "bundle_id": { "type": "string", "minLength": 1 },
        "error_code": {
          "type": "string",
          "enum": [
            "transport",
            "browser_launch",
            "profile_locked",
            "auth_required",
            "capability_missing",
            "action_timeout",
            "ui_drift",
            "download_failed",
            "upload_failed",
            "research_job_failed"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "url": { "type": ["string", "null"], "minLength": 1 },
        "mode": {
          "type": ["string", "null"],
          "enum": ["normal", "search", "research", null]
        },
        "screenshot_path": { "type": ["string", "null"], "minLength": 1 },
        "dom_snapshot_path": { "type": ["string", "null"], "minLength": 1 },
        "aria_snapshot_path": { "type": ["string", "null"], "minLength": 1 },
        "logs_path": { "type": ["string", "null"], "minLength": 1 },
        "strategy_attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/strategy_attempt" }
        },
        "capability_matrix": { "$ref": "#/$defs/capability_matrix" }
      }
    },
    "health_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_at",
        "browser_connected",
        "extension_connected",
        "authenticated",
        "details"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "degraded", "down"]
        },
        "checked_at": { "type": "string", "format": "date-time" },
        "browser_connected": { "type": "boolean" },
        "extension_connected": { "type": "boolean" },
        "authenticated": { "type": "boolean" },
        "details": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
