{
  "name": "tablinq",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test:browser-adapter:ask": "pnpm exec vitest run packages/browser-adapter/test/browser-adapter.ask.attach.test.ts packages/browser-adapter/test/browser-adapter.ask.configuration.test.ts packages/browser-adapter/test/browser-adapter.ask.errors.test.ts packages/browser-adapter/test/browser-adapter.ask.streaming.test.ts packages/browser-adapter/test/browser-adapter.ask.submit.test.ts packages/browser-adapter/test/browser-adapter.ask.uploads-artifacts.test.ts --reporter=dot",
    "test:browser-adapter:foundation": "pnpm exec vitest run packages/browser-adapter/test/browser-adapter.foundation.capabilities.test.ts packages/browser-adapter/test/browser-adapter.foundation.composer-input.test.ts packages/browser-adapter/test/browser-adapter.foundation.launch-artifacts.test.ts packages/browser-adapter/test/browser-adapter.foundation.pacing-retry.test.ts packages/browser-adapter/test/browser-adapter.foundation.runtime-bridge.test.ts packages/browser-adapter/test/browser-adapter.foundation.session.test.ts --reporter=dot",
    "test:browser-adapter:recovery": "pnpm exec vitest run packages/browser-adapter/test/browser-adapter.recovery.ask-reconciliation.test.ts packages/browser-adapter/test/browser-adapter.recovery.ask-streaming.test.ts packages/browser-adapter/test/browser-adapter.recovery.attach.test.ts packages/browser-adapter/test/browser-adapter.recovery.primitives.test.ts --reporter=dot",
    "test:browser-adapter:research": "pnpm exec vitest run packages/browser-adapter/test/browser-adapter.research.test.ts --reporter=dot",
    "test:ts:fast": "pnpm exec vitest run packages/browser-adapter/test/protocol-schemas.test.ts packages/browser-adapter/test/selector-pack.test.ts packages/extension/test/probe.test.ts packages/extension/test/content-script.test.ts --reporter=dot",
    "ci:local": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job quick",
    "ci:local:all": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job all",
    "ci:local:rust:fmt": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job rust-fmt",
    "ci:local:rust:clippy": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job rust-clippy",
    "ci:local:rust:test": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job rust-test",
    "ci:local:package-smoke": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job package-smoke",
    "ci:local:rust": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job rust",
    "ci:local:typescript": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job typescript",
    "ci:local:browser-adapter:foundation": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job browser-adapter-foundation",
    "ci:local:browser-adapter:ask": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job browser-adapter-ask",
    "ci:local:browser-adapter:research": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job browser-adapter-research",
    "ci:local:browser-adapter:recovery": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 -Job browser-adapter-recovery",
    "test:local": "python scripts/test_local.py",
    "test:local:aggressive": "python scripts/test_local.py --profile aggressive",
    "test:local:balanced": "python scripts/test_local.py --profile balanced",
    "lint": "pnpm --filter @tablinq/extension run check:probe-content && pnpm exec tsc -p packages/browser-adapter/tsconfig.json --noEmit && pnpm exec tsc -p packages/extension/tsconfig.json --noEmit",
    "format": "pnpm exec prettier --check \"**/*.{json,md,ts,js,html,yml,yaml}\"",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package.ps1",
    "test": "pnpm exec vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "tsx": "^4.20.6",
    "vitest": "^3.1.1"
  }
}
