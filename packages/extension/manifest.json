{
  "manifest_version": 3,
  "name": "Tablinq Bridge",
  "version": "0.1.0",
  "key": "",
  "description": "Semantic bridge for a managed ChatGPT browser session.",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["src/probe.content.js", "src/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
